# Copy to .env and fill in your values.
# Firebase web API key (same as VITE_FIREBASE_API_KEY in the ALLXCHAT app).
FIREBASE_API_KEY=

# Dedicated ALLXCHAT bot account used by the bridge (create a free account
# once via the ALLXCHAT signup page, then put its email/password here).
BRIDGE_EMAIL=
BRIDGE_PASSWORD=

# Your ALLXCHAT user id (uid) — shown in Firebase Console -> Authentication
# -> Users, or from the browser console: JSON.parse(localStorage... ) no:
# it is the uid of your ALLXCHAT account.
ALLXCHAT_UID=

# Realtime Database URL of project allxchat-12a8b.
RTDB_URL=https://allxchat-12a8b-default-rtdb.asia-southeast1.firebasedatabase.app

# Display name used for relayed messages.
BRIDGE_NAME=WhatsApp Bridge

# Port for the local QR page (/qr)
PORT=3000

# Bearer token required on /send and /status (auto-generated + saved to .env on first run if missing).
BRIDGE_TOKEN=
