{
  "rules": {
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChildren(['username', 'displayName', 'about', 'isOnline', 'lastSeen', 'createdAt', 'updatedAt'])",
        "username": { ".validate": "newData.isString()" },
        "displayName": { ".validate": "newData.isString()" },
        "avatarUrl": { ".validate": "newData.val() == null || newData.isString()" },
        "about": { ".validate": "newData.isString()" },
        "isOnline": { ".validate": "newData.isBoolean()" },
        "lastSeen": { ".validate": "newData.isString()" },
        "createdAt": { ".validate": "(!data.exists() || newData.val() == data.val()) && newData.isString()" },
        "updatedAt": { ".validate": "newData.isString() || !newData.exists()" }
      }
    },
    "usernames": {
      ".read": "auth != null",
      "$username": {
        ".write": "auth != null && ((!data.exists() && newData.child('uid').val() == auth.uid) || (data.exists() && data.child('uid').val() == auth.uid))",
        ".validate": "newData.exists() == false || (newData.child('uid').isString() && newData.child('uid').val() == auth.uid)"
      }
    },
    "userConversations": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        "$cid": {
          ".write": "auth != null && (auth.uid == $uid || (newData.val() == true && root.child('conversations').child($cid).child('participantIds').child(auth.uid).exists()) || (!newData.exists() && root.child('conversations').child($cid).child('roles').child(auth.uid).val() == 'admin'))",
          ".validate": "newData.val() == true || !newData.exists()"
        }
      }
    },
    "conversations": {
      "$cid": {
        ".read": "auth != null && data.child('participantIds').child(auth.uid).exists()",
        ".write": "auth != null && ((!data.exists() && newData.child('createdBy').val() == auth.uid && newData.child('participantIds').child(auth.uid).exists()) || (data.exists() && newData.exists() && data.child('participantIds').child(auth.uid).exists()) || (!newData.exists() && data.child('createdBy').val() == auth.uid))",
        "createdBy": { ".validate": "!data.exists() || newData.val() == data.val()" },
        "isGroup": { ".validate": "!data.exists() || newData.val() == data.val()" },
        "directKey": { ".validate": "newData.val() == null || newData.isString()" },
        "createdAt": { ".validate": "!data.exists() || newData.val() == data.val()" },
        "title": { ".validate": "newData.val() == null || newData.isString()" },
        "avatarUrl": { ".validate": "newData.val() == null || newData.isString()" },
        "participantIds": {
          "$pid": {
            ".validate": "newData.val() == null || newData.val() == true"
          }
        },
        "roles": {
          "$roleUid": {
            ".validate": "newData.val() == null || newData.val() == 'admin' || newData.val() == 'member'"
          }
        },
        "joinedAt": {
          "$key": { ".validate": "newData.val() == null || newData.isString()" }
        },
        "lastReadAt": {
          "$key": { ".validate": "newData.val() == null || newData.isString()" }
        },
        "lastDeliveredAt": {
          "$key": { ".validate": "newData.val() == null || newData.isString()" }
        },
        "messages": {
          ".indexOn": ["createdAt"],
          "$mid": {
            ".validate": "(!data.exists() && newData.exists() && newData.child('senderId').val() == auth.uid && newData.child('messageType').val() != 'system') || (data.exists() && newData.exists() && newData.child('senderId').val() == data.child('senderId').val()) || (!newData.exists())",
            "senderId": { ".validate": "newData.isString()" },
            "content": { ".validate": "newData.val() == null || newData.isString()" },
            "messageType": { ".validate": "newData.isString() && (newData.val() == 'text' || newData.val() == 'image' || newData.val() == 'audio' || newData.val() == 'file' || newData.val() == 'call')" },
            "filePath": { ".validate": "newData.val() == null || newData.isString()" },
            "fileName": { ".validate": "newData.val() == null || newData.isString()" },
            "fileMime": { ".validate": "newData.val() == null || newData.isString()" },
            "fileSize": { ".validate": "newData.val() == null || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 5242880)" },
            "recipientCount": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "createdAt": { ".validate": "newData.isString()" },
            "clientId": { ".validate": "newData.val() == null || newData.isString()" },
            "readAtBy": {
              "$uid": { ".validate": "$uid == auth.uid || !newData.parent().parent().exists()" }
            },
            "deliveredAtBy": {
              "$uid": { ".validate": "$uid == auth.uid || !newData.parent().parent().exists()" }
            },
            "reactions": {
              "$emoji": {
                "$uid": {
                  ".validate": "($uid == auth.uid || !newData.parent().parent().exists()) && (newData.val() == true || !newData.exists())"
                }
              }
            }
          }
        }
      }
    },
    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "typing": {
      "$conversationId": {
        "$uid": {
          ".read": "auth != null && root.child('conversations').child($conversationId).child('participantIds').child(auth.uid).exists()",
          ".write": "auth != null && auth.uid == $uid && root.child('conversations').child($conversationId).child('participantIds').child(auth.uid).exists()"
        }
      }
    },
    "pushSubscriptions": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "calls": {
      "$conversationId": {
        "$callId": {
          ".read": "auth != null && root.child('conversations').child($conversationId).child('participantIds').child(auth.uid).exists()",
          ".write": "auth != null && root.child('conversations').child($conversationId).child('participantIds').child(auth.uid).exists()",
          "callerId": { ".validate": "newData.isString()" },
          "calleeId": { ".validate": "newData.isString()" },
          "type": { ".validate": "newData.isString() && (newData.val() == 'voice' || newData.val() == 'video')" },
          "status": { ".validate": "newData.isString() && (newData.val() == 'ringing' || newData.val() == 'accepted' || newData.val() == 'rejected' || newData.val() == 'ended' || newData.val() == 'missed')" },
          "offer": { ".validate": "newData.val() == null || newData.isString()" },
          "answer": { ".validate": "newData.val() == null || newData.isString()" },
          "createdAt": { ".validate": "newData.isString()" },
          "iceCandidates": {
            "$uid": {
              "$candidateId": {
                ".validate": "$uid == auth.uid"
              }
            }
          }
        }
      }
    }
  }
}
